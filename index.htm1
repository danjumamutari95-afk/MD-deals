<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MD Deals</title>
  <style>
    body {font-family: Arial; margin:0; background:#f5f5f5; color:#222}
    header {background:#111; color:white; padding:20px; text-align:center}
    .hero {padding:50px 20px; text-align:center; background:white}
    .hero h1 {font-size:38px}
    .products {display:grid; gap:20px; padding:25px}
    .card {background:white; padding:20px; border-radius:15px; text-align:center}
    .emoji {font-size:60px}
    .buy {display:block; background:#111; color:white; padding:12px; border-radius:8px; text-decoration:none}
  </style>
</head>

<body>

<header>
  <h2>MD Deals 🛍️</h2>
  <p>Smart deals, great products</p>
</header>

<section class="hero">
  <h1>Find Great Deals 🔥</h1>
  <p>Discover useful products at great prices.</p>
</section>

<section class="products">

  <div class="card">
    <div class="emoji">🎧</div>
    <h2>Wireless Earbuds</h2>
    <p>Great for music, calls and everyday use.</p>
    <a class="buy" href="#">View Deal</a>
  </div>

  <div class="card">
    <div class="emoji">⌚</div>
    <h2>Smart Watch</h2>
    <p>A useful accessory for everyday life.</p>
    <a class="buy" href="#">View Deal</a>
  </div>

  <div class="card">
    <div class="emoji">📱</div>
    <h2>Phone Accessories</h2>
    <p>Useful accessories for your smartphone.</p>
    <a class="buy" href="#">View Deal</a>
  </div>

</section>

<footer style="text-align:center;padding:25px">
  © 2026 MD Deals
</footer>

</body>
  </html>
